{
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": {
            "eq": "primes-ring-website-p9yv.vercel.app"
          }
        }
      ],
      "destination": "https://saturnringlab.com/",
      "permanent": true
    },
    {
      "source": "/:section(data|datasets|research|planet|rings|moons|missions)",
      "has": [
        {
          "type": "host",
          "value": {
            "eq": "primes-ring-website-p9yv.vercel.app"
          }
        }
      ],
      "destination": "https://saturnringlab.com/:section",
      "permanent": true
    },
    {
      "source": "/:section(data|datasets|research)/:slug",
      "has": [
        {
          "type": "host",
          "value": {
            "eq": "primes-ring-website-p9yv.vercel.app"
          }
        }
      ],
      "destination": "https://saturnringlab.com/:section/:slug",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": {
            "eq": "www.saturnringlab.com"
          }
        }
      ],
      "destination": "https://saturnringlab.com/",
      "permanent": true
    },
    {
      "source": "/:section(data|datasets|research|planet|rings|moons|missions)",
      "has": [
        {
          "type": "host",
          "value": {
            "eq": "www.saturnringlab.com"
          }
        }
      ],
      "destination": "https://saturnringlab.com/:section",
      "permanent": true
    },
    {
      "source": "/:section(data|datasets|research)/:slug",
      "has": [
        {
          "type": "host",
          "value": {
            "eq": "www.saturnringlab.com"
          }
        }
      ],
      "destination": "https://saturnringlab.com/:section/:slug",
      "permanent": true
    },
    {
      "source": "/research",
      "destination": "/rings",
      "permanent": false
    },
    {
      "source": "/research/:path*",
      "destination": "/rings",
      "permanent": false
    },
    {
      "source": "/viewer",
      "destination": "/data",
      "permanent": true
    },
    {
      "source": "/data-hub",
      "destination": "/data",
      "permanent": true
    },
    {
      "source": "/math",
      "destination": "/rings",
      "permanent": true
    },
    {
      "source": "/algorithms",
      "destination": "/rings",
      "permanent": true
    },
    {
      "source": "/algorithms/:slug",
      "destination": "/rings",
      "permanent": true
    },
    {
      "source": "/overview",
      "destination": "/rings",
      "permanent": true
    },
    {
      "source": "/progress",
      "destination": "/explorations",
      "permanent": true
    },
    {
      "source": "/team",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/background",
      "destination": "/resources",
      "permanent": true
    },
    {
      "source": "/gallery",
      "destination": "/resources",
      "permanent": true
    },
    {
      "source": "/resources",
      "destination": "/?about=sources",
      "permanent": true
    }
  ],
  "rewrites": [
